# ---------------------------------------------------------------------------
# Desenvolvimento local. Para os valores de PRODUÇÃO, ver a tabela em DEPLOY.md.
# Este arquivo é versionado: nunca coloque segredos reais aqui.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Banco — em desenvolvimento, campos avulsos apontando para o Postgres local.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=acpb_db
DATABASE_USER=acpb_app
DATABASE_PASSWORD=

# Em produção, use a connection string do provedor (Neon) no lugar dos campos acima.
# Ela já traz o sslmode=require, que se perderia ao remontar a URI por partes.
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.neon.tech/acpb?sslmode=require

# Duas entradas porque localhost e 127.0.0.1 sao origens distintas para o navegador.
BACKEND_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# URL pública do frontend — usada para montar o link no e-mail de redefinição de senha.
FRONTEND_URL=http://localhost:5174

# Gere um valor forte por ambiente: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA reutilize o valor de exemplo abaixo em produção.
JWT_SECRET_KEY=troque-este-valor-em-desenvolvimento
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30

# Armazenamento de arquivos (anexos financeiros e fotos).
#   local = disco (desenvolvimento)
#   s3    = object storage S3-compatível (produção — obrigatório, o disco de PaaS é efêmero)
STORAGE_BACKEND=local
ANEXOS_TAMANHO_MAXIMO_MB=5
FOTOS_TAMANHO_MAXIMO_MB=2

# Credenciais do Cloudflare R2 — só em produção (STORAGE_BACKEND=s3).
# S3_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# S3_BUCKET=acpb-arquivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# SMTP para o e-mail de recuperação de senha. Sem isso, em desenvolvimento o token cai
# no log; em produção a aplicação se recusa a subir (seria vazamento de credencial).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=sistema@acpb.org.br
# SMTP_FROM_NOME=Sistema ACPB
