DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=acpb_db
DATABASE_USER=acpb_app
DATABASE_PASSWORD=

BACKEND_CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# Gere um valor forte por ambiente, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA reutilize o valor de exemplo abaixo em produção.
JWT_SECRET_KEY=troque-este-valor-em-desenvolvimento
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30
